.venv/
__pycache__/
*.pyc
.env
.ipynb_checkpoints/
mlruns/
*.egg-info/
.DS_Store

# Phase 3 -- fitted models are reproducible artifacts, not source.
# The contents are ignored rather than the directory: git does not descend into
# an ignored directory, so `/models/` would swallow the README that explains
# what the directory is for.
/models/*
!/models/README.md

# Dashboard publishing target: self-contained copies of reports/*.html, served
# by Streamlit so each report has its own URL. Regenerated on demand from
# reports/, so it is output rather than source.
/static/

# Local preview/launch configuration for the coding agent, not part of the app.
/.claude/

# Personal demo notes -- reference only, not part of the deliverable.
/docs/demo-script.md

# Streamlit Cloud secrets are pasted in the web UI. A local copy of this file
# holds a real API key -- never commit it. (.streamlit/config.toml IS tracked.)
/.streamlit/secrets.toml

# Recorded demo footage -- large, and uploaded rather than committed.
/docs/demo/
