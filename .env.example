# Copy this file to .env and add your key. .env is gitignored.
#
# Any OpenAI-compatible provider works. The client detects which one from the
# key's prefix, so usually the key is the only line you need:
#
#   gsk_...   Groq    https://console.groq.com/keys
#   xai-...   xAI     https://console.x.ai
#   sk-...    OpenAI  https://platform.openai.com/api-keys

# XAI_API_KEY is also accepted as an alias for compatibility with the existing
# .env in this project. The variable's name does not decide the provider -- the
# key's prefix does -- so a Groq key under XAI_API_KEY works correctly.
LLM_API_KEY=your_api_key_here

# Optional. Set either of these to override what the key prefix implies.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Where the required prompt/model/timestamp/output audit trail is written
LLM_LOG_PATH=reports/llm_prompt_log.jsonl
