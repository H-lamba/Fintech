# Copy this file to .env and fill in your key. .env is gitignored.
# Get an xAI API key at https://console.groq.com/keys

XAI_API_KEY=your_xai_api_key_here

# Grok exposes an OpenAI-compatible endpoint, so any OpenAI-compatible
# provider can be swapped in by changing these two values.
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4

# Where the required prompt/model/timestamp/output audit trail is written
LLM_LOG_PATH=reports/llm_prompt_log.jsonl
